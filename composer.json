{
    "name": "kekos/http-emitter",
    "type": "library",
    "description": "Emitting PSR-7 responses.",
    "keywords": [
        "narrowspark",
        "http",
        "emitter",
        "sapi",
        "psr-7"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Bannert",
            "email": "d.bannert@anolilab.de",
            "homepage": "http://www.anolilab.de",
            "role": "Developer"
        },
        {
            "name": "Christoffer Lindahl Hassel",
            "homepage": "https://kekos.se",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^1.0 || ^2.0",
        "thecodingmachine/safe": "^1.3.3"
    },
    "require-dev": {
        "ext-json": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "laminas/laminas-diactoros": "^3.7",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5",
        "thecodingmachine/phpstan-safe-rule": "^1.4"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Kekos\\HttpEmitter\\": "src/"
        },
        "exclude-from-classmap": [
            "tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kekos\\HttpEmitter\\Tests\\": "tests/"
        },
        "files": [
            "tests/OverwritePhpFunctions.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs": "php-cs-fixer fix --config=\"./.php-cs-fixer.dist.php\" --ansi",
        "cs:check": "php-cs-fixer fix --config=\"./.php-cs-fixer.dist.php\" --ansi --dry-run",
        "phpstan": "phpstan analyse --configuration ./phpstan.neon --ansi --memory-limit=-1",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html=./.build/phpunit/coverage"
    },
    "support": {
        "issues": "https://github.com/Kekos/http-emitter/issues",
        "source": "https://github.com/Kekos/http-emitter"
    }
}
